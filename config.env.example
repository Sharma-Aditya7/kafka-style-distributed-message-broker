# YAK Message Broker - Configuration Template
#
# Copy this file to config.env and fill in the addresses for your deployment:
#   cp config.env.example config.env
#
# For a single-machine run, the defaults below (localhost) work as-is.
# For a multi-machine run, replace each host with the real IP of that node.

# ============================================
# Node 1: Leader Broker
# ============================================
LEADER_HOST=localhost
LEADER_PORT=9092

# ============================================
# Node 2: Follower Broker
# ============================================
FOLLOWER_HOST=localhost
FOLLOWER_PORT=9093

# ============================================
# Redis (coordination store)
# ============================================
# In the 4-node deployment Redis runs on Node 2, alongside the follower.
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# Node 3: Producer
# ============================================
PRODUCER_HOST=localhost

# ============================================
# Node 4: Consumer
# ============================================
CONSUMER_HOST=localhost
CONSUMER_ID=consumer-1

# ============================================
# Leader Lease / Failure Detection
# ============================================
# How long a leader lease stays valid in Redis before expiring (seconds).
LEADER_LEASE_TTL=30

# How often the leader renews its lease, and how often the follower checks it.
HEARTBEAT_INTERVAL=5

# Informational: the follower elects after 3 consecutive missed checks,
# i.e. roughly 3 * HEARTBEAT_INTERVAL seconds.
HEARTBEAT_TIMEOUT=15

# ============================================
# Replication
# ============================================
# Socket timeout for leader -> follower replication calls (seconds).
REPLICATION_TIMEOUT=10

# Reserved for future batched replication; the current implementation
# replicates one message per round trip.
MAX_BATCH_SIZE=100

# ============================================
# Consumer Fetch
# ============================================
# Maximum messages returned per FETCH request.
FETCH_MAX_MESSAGES=100

# ============================================
# Network
# ============================================
SOCKET_TIMEOUT=30
RECONNECT_DELAY=2
MAX_RETRIES=3
