# YAK Message Broker Configuration
# Copy this file to config.env and update with your actual values

# ============================================
# Node 1: Leader Broker Configuration
# ============================================
LEADER_HOST=172.23.51.66
LEADER_PORT=9092

# ============================================
# Node 2: Follower Broker Configuration
# ============================================
FOLLOWER_HOST=172.23.159.119
FOLLOWER_PORT=9093

# Redis is typically run on the same machine as follower (Node 2)
REDIS_HOST=172.23.202.101
REDIS_PORT=6379

# ============================================
# Leader Lease Configuration
# ============================================
# How long the leader lease is valid (seconds)
LEADER_LEASE_TTL=30

# How often leader renews the lease (seconds)
HEARTBEAT_INTERVAL=5

# How long to wait before declaring leader dead (seconds)
# Should be >= 3 * HEARTBEAT_INTERVAL
HEARTBEAT_TIMEOUT=15

# ============================================
# Replication Configuration
# ============================================
# Timeout for replication requests (seconds)
REPLICATION_TIMEOUT=10

# Maximum messages per batch
MAX_BATCH_SIZE=100

# ============================================
# Consumer Configuration
# ============================================
# Default consumer ID
CONSUMER_ID=consumer-1

# Maximum messages to fetch per request
FETCH_MAX_MESSAGES=100

# ============================================
# Producer Configuration
# ============================================
# Producer Node
PRODUCER_HOST=172.23.202.121

# ============================================
# Consumer Node
# ============================================
CONSUMER_HOST=172.23.198.10

# ============================================
# Network Configuration
# ============================================
# Socket timeout (seconds)
SOCKET_TIMEOUT=30

# Delay between reconnection attempts (seconds)
RECONNECT_DELAY=2

# Maximum retry attempts for operations
MAX_RETRIES=3

# ============================================
# INSTRUCTIONS FOR EACH TEAM MEMBER
# ============================================

# Person 1 (Leader Broker - Node 1):
# Update LEADER_HOST with your machine's IP address
# Ensure FOLLOWER_HOST points to Person 2's machine
# Ensure REDIS_HOST points to Person 2's machine (or wherever Redis is running)

# Person 2 (Follower Broker - Node 2):
# Update FOLLOWER_HOST with your machine's IP address
# Update REDIS_HOST with your machine's IP (if running Redis locally)
# Ensure Redis server is installed and running on port 6379

# Person 3 (Producer - Node 3):
# Update LEADER_HOST and FOLLOWER_HOST to point to actual broker IPs
# Update REDIS_HOST to point to the Redis server IP

# Person 4 (Consumer - Node 4):
# Update LEADER_HOST and FOLLOWER_HOST to point to actual broker IPs
# Update REDIS_HOST to point to the Redis server IP
# Update CONSUMER_ID if running multiple consumers

# Sharma: 172.23.51.66
# Laxman: 172.23.202.101
# Devy: 172.23.198.10
# Rishika: 172.23.202.121